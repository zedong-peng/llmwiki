.DS_Store
.env
.env.*
__pycache__/
.pytest_cache/
.venv/
node_modules/
dist/
build/

# Keep raw/private material out of git by default.
raw/**
!raw/
!raw/README.md
private/**
!private/


# Large generated/binary paper materials (original archives stay local; sha256 is in metadata.yaml)
**/paper-tex/archives/
**/paper-tex/extracted/**/*.bin
**/paper-tex/extracted/**/*.pdf
**/supplementary/**/*.bin
**/supplementary/**/*.v
**/supplementary/**/*.sv
**/supplementary/**/*.tcl
**/supplementary/**/*.bit
**/supplementary/**/*.tar.gz
**/profile/profile/

# Cached GitHub clones of paper code (embedded git repos, large binaries); provenance lives in metadata.yaml
**/github-repo/
