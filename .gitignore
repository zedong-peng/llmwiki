.DS_Store
.env
.env.*
__pycache__/
.pytest_cache/
.venv/
node_modules/
dist/
build/

# Keep raw/private material out of git by default.
raw/**
!raw/
!raw/README.md
private/**
!private/

# Exclude all research paper repos (embedded git repos and their .env files)
**/repo/

# Large generated/binary paper materials
**/source/extracted/**/*.bin
**/source/extracted/**/*.pdf
**/supplementary/**/*.bin
**/supplementary/**/*.v
**/supplementary/**/*.sv
**/supplementary/**/*.tcl
**/supplementary/**/*.bit
**/supplementary/**/*.tar.gz
**/profile/profile/
**/source/archives/
