.DS_Store
.env
.env.*
__pycache__/
.pytest_cache/
.venv/
node_modules/
dist/
build/

# Keep raw/private material out of git by default.
raw/**
!raw/
!raw/README.md
private/**
!private/


# Recoverable caches: restore with llmwiki-skill scripts/fetch_assets.py (URL, sha256 and commit are in metadata.yaml).
# Paper PDFs and the full extracted TeX tree (figures included) are tracked.
**/paper-tex/archives/
**/supplementary/**/*.bin
**/supplementary/**/*.v
**/supplementary/**/*.sv
**/supplementary/**/*.tcl
**/supplementary/**/*.bit
**/supplementary/**/*.tar.gz
**/profile/profile/

**/github-repo/
