@inproceedings{luo_knowledge_2018,
	address = {Brussels, Belgium},
	title = {Knowledge {Base} {Question} {Answering} via {Encoding} of {Complex} {Query} {Graphs}},
	url = {http://aclweb.org/anthology/D18-1242},
	doi = {10.18653/v1/D18-1242},
	abstract = {Answering complex questions that involve multiple entities and multiple relations using a standard knowledge base is an open and challenging task. Most existing KBQA approaches focus on simpler questions and do not work very well on complex questions because they were not able to simultaneously represent the question and the corresponding complex query structure. In this work, we encode such complex query structure into a uniform vector representation, and thus successfully capture the interactions between individual semantic components within a complex question. This approach consistently outperforms existing methods on complex questions while staying competitive on simple questions.},
	language = {en},
	urldate = {2024-06-13},
	booktitle = {Proceedings of the 2018 {Conference} on {Empirical} {Methods} in {Natural} {Language} {Processing}},
	publisher = {Association for Computational Linguistics},
	author = {Luo, Kangqi and Lin, Fengli and Luo, Xusheng and Zhu, Kenny},
	year = {2018},
	pages = {2185--2194},
}

@inproceedings{hu_state-transition_2018,
	address = {Brussels, Belgium},
	title = {A {State}-transition {Framework} to {Answer} {Complex} {Questions} over {Knowledge} {Base}},
	url = {http://aclweb.org/anthology/D18-1234},
	doi = {10.18653/v1/D18-1234},
	abstract = {Although natural language question answering over knowledge graphs have been studied in the literature, existing methods have some limitations in answering complex questions. To address that, in this paper, we propose a State Transition-based approach to translate a complex natural language question N to a semantic query graph (SQG) QS, which is used to match the underlying knowledge graph to ﬁnd the answers to question N . In order to generate QS, we propose four primitive operations (expand, fold, connect and merge) and a learning-based state transition approach. Extensive experiments on several benchmarks (such as QALD, WebQuestions and ComplexQuestions) with two knowledge bases (DBpedia and Freebase) conﬁrm the superiority of our approach compared with stateof-the-arts.},
	language = {en},
	urldate = {2024-06-13},
	booktitle = {Proceedings of the 2018 {Conference} on {Empirical} {Methods} in {Natural} {Language} {Processing}},
	publisher = {Association for Computational Linguistics},
	author = {Hu, Sen and Zou, Lei and Zhang, Xinbo},
	year = {2018},
	pages = {2098--2108},
}

@inproceedings{sun_expnote_2023,
	address = {Singapore},
	title = {{ExpNote}: {Black}-box {Large} {Language} {Models} are better {Task} {Solvers} with {Experience} {Notebook}},
	shorttitle = {{ExpNote}},
	url = {https://aclanthology.org/2023.findings-emnlp.1034},
	doi = {10.18653/v1/2023.findings-emnlp.1034},
	abstract = {Black-box Large Language Models (LLMs) have shown great power in solving various tasks and are considered general problem solvers. However, LLMs still fail in many specific tasks although understand the task instruction. In this paper, we focus on the problem of boosting the ability of black-box LLMs to solve downstream tasks. We propose ExpNote, an automated framework to help LLMs better adapt to unfamiliar tasks through reflecting and noting experiences from training data and retrieving them from external memory during testing. We evaluate ExpNote on multiple tasks and the experimental results demonstrate that the proposed method significantly improves the performance of black-box LLMs. The data and code are available at https://github.com/forangel2014/ExpNote.},
	language = {en},
	urldate = {2024-06-12},
	booktitle = {Findings of the {Association} for {Computational} {Linguistics}: {EMNLP} 2023},
	publisher = {Association for Computational Linguistics},
	author = {Sun, Wangtao and Yu, Xuanqing and He, Shizhu and Zhao, Jun and Liu, Kang},
	year = {2023},
	pages = {15470--15481},
}

