@article{jin_significance_2015,
	series = {Visions on {Big} {Data}},
	title = {Significance and {Challenges} of {Big} {Data} {Research}},
	volume = {2},
	issn = {2214-5796},
	url = {https://www.sciencedirect.com/science/article/pii/S2214579615000076},
	doi = {10.1016/j.bdr.2015.01.006},
	abstract = {In recent years, the rapid development of Internet, Internet of Things, and Cloud Computing have led to the explosive growth of data in almost every industry and business area. Big data has rapidly developed into a hot topic that attracts extensive attention from academia, industry, and governments around the world. In this position paper, we first briefly introduce the concept of big data, including its definition, features, and value. We then identify from different perspectives the significance and opportunities that big data brings to us. Next, we present representative big data initiatives all over the world. We describe the grand challenges (namely, data complexity, computational complexity, and system complexity), as well as possible solutions to address these challenges. Finally, we conclude the paper by presenting several suggestions on carrying out big data projects.},
	number = {2},
	urldate = {2024-11-03},
	journal = {Big Data Research},
	author = {Jin, Xiaolong and Wah, Benjamin W. and Cheng, Xueqi and Wang, Yuanzhuo},
	month = jun,
	year = {2015},
	keywords = {Big data, Computational complexity, Data complexity, System complexity},
	pages = {59--64},
}

@article{wang_network_2014,
	title = {Network {Big} {Data}: {Present} and {Future}: {Network} {Big} {Data}: {Present} and {Future}},
	volume = {36},
	issn = {0254-4164},
	shorttitle = {Network {Big} {Data}},
	url = {http://pub.chinasciencejournal.com/article/getArticleRedirect.action?doiCode=10.3724/SP.J.1016.2013.01125},
	doi = {10.3724/SP.J.1016.2013.01125},
	abstract = {Network big data refer to the massive data generated by interaction and fusion of the ternary human-machine-thing universe in the Cyberspace and available on the Internet. The increase of their scale and complexity exceeds that of the capacity of hardware characterized by the Moore law, which brings grand challenges to the architecture and the processing and computing capacity of the contemporary IT systems, meanwhile presents unprecedented opportunities on deeply mining and taking full advantage of the big value of network big data. Therefore, it is pressing to investigate the disciplinary issues and discover the common laws of network big data, and further study the fundamental theory and basic approach to qualitatively or quantitatively dealing with network big data. This paper analyzes the challenges caused by the complexity, uncertainty and emergence of network big data, and summarizes major issues and research status of the awareness, representation, storage, management, mining, and social computing of network big data, as well as network data platforms and applications. It also looks ahead to the development trends of big data science, new modes and paradigm of data computing, new IT infrastructures, and data security and privacy, etc.},
	language = {zh},
	number = {6},
	urldate = {2024-11-03},
	journal = {Chinese Journal of Computers},
	author = {Wang, Yuan-Zhuo and Jin, Xiao-Long and Cheng, Xue-Qi},
	month = mar,
	year = {2014},
	pages = {1125--1138},
}

