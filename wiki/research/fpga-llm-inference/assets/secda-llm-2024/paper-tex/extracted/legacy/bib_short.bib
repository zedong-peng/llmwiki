author = {Crockett, Louise H. and Elliot, Ross A. and Enderwitz, Martin A. and Stewart, Robert W.},
title = {The Zynq Book: Embedded Processing with the Arm Cortex-A9 on the Xilinx Zynq-7000 All Programmable Soc},
year = {2014},
