	doi = {10.1145/3404835.3463238},
	isbn = {9781450380379},
	keywords = {first-stage retrieval, open-source search engine},
	location = {<conf-loc>, <city>Virtual Event</city>, <country>Canada</country>, </conf-loc>},
	numpages = {7},
