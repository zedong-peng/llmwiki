@online{wangLinformerSelfAttentionLinear2020,
  title = {Linformer: {{Self-Attention}} with {{Linear Complexity}}},
  shorttitle = {Linformer},
  author = {Wang, Sinong and Li, Belinda Z. and Khabsa, Madian and Fang, Han and Ma, Hao},
  date = {2020-06-14},
  eprint = {2006.04768},
  eprinttype = {arxiv},
  eprintclass = {cs, stat},
  doi = {10.48550/arXiv.2006.04768},
  url = {http://arxiv.org/abs/2006.04768},
  urldate = {2023-12-14},
  abstract = {Large transformer models have shown extraordinary success in achieving state-of-the-art results in many natural language processing applications. However, training and deploying these models can be prohibitively costly for long sequences, as the standard self-attention mechanism of the Transformer uses \$O(n\^2)\$ time and space with respect to sequence length. In this paper, we demonstrate that the self-attention mechanism can be approximated by a low-rank matrix. We further exploit this finding to propose a new self-attention mechanism, which reduces the overall self-attention complexity from \$O(n\^2)\$ to \$O(n)\$ in both time and space. The resulting linear transformer, the \textbackslash textit\{Linformer\}, performs on par with standard Transformer models, while being much more memory- and time-efficient.},
  pubstate = {preprint},
  keywords = {Computer Science - Machine Learning,Statistics - Machine Learning},
  file = {C\:\\Users\\monte\\Zotero\\storage\\S6TGLV9A\\Wang et al. - 2020 - Linformer Self-Attention with Linear Complexity.pdf;C\:\\Users\\monte\\Zotero\\storage\\UJ9BNI6R\\2006.html}
}

@online{xiongNystrOmformerNystr2021,
  title = {Nystr\textbackslash "omformer: {{A Nystr}}\textbackslash "om-{{Based Algorithm}} for {{Approximating Self-Attention}}},
  shorttitle = {Nystr\textbackslash "omformer},
  author = {Xiong, Yunyang and Zeng, Zhanpeng and Chakraborty, Rudrasis and Tan, Mingxing and Fung, Glenn and Li, Yin and Singh, Vikas},
  date = {2021-03-31},
  eprint = {2102.03902},
  eprinttype = {arxiv},
  eprintclass = {cs},
  doi = {10.48550/arXiv.2102.03902},
  url = {http://arxiv.org/abs/2102.03902},
  urldate = {2024-01-17},
  abstract = {Transformers have emerged as a powerful tool for a broad range of natural language processing tasks. A key component that drives the impressive performance of Transformers is the self-attention mechanism that encodes the influence or dependence of other tokens on each specific token. While beneficial, the quadratic complexity of self-attention on the input sequence length has limited its application to longer sequences -- a topic being actively studied in the community. To address this limitation, we propose Nystr\textbackslash "\{o\}mformer -- a model that exhibits favorable scalability as a function of sequence length. Our idea is based on adapting the Nystr\textbackslash "\{o\}m method to approximate standard self-attention with \$O(n)\$ complexity. The scalability of Nystr\textbackslash "\{o\}mformer enables application to longer sequences with thousands of tokens. We perform evaluations on multiple downstream tasks on the GLUE benchmark and IMDB reviews with standard sequence length, and find that our Nystr\textbackslash "\{o\}mformer performs comparably, or in a few cases, even slightly better, than standard self-attention. On longer sequence tasks in the Long Range Arena (LRA) benchmark, Nystr\textbackslash "\{o\}mformer performs favorably relative to other efficient self-attention methods. Our code is available at https://github.com/mlpen/Nystromformer.},
  pubstate = {preprint},
  keywords = {Computer Science - Computation and Language,Computer Science - Machine Learning},
  file = {C\:\\Users\\monte\\Zotero\\storage\\XIZIIWAU\\Xiong et al. - 2021 - Nystromformer A Nystrom-Based Algorithm for A.pdf;C\:\\Users\\monte\\Zotero\\storage\\FGDYNIWJ\\2102.html}
}
