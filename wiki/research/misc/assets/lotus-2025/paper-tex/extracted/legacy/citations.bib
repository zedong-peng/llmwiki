ISBN: 9781728129037
Place: Dallas, TX, USA
Publisher: IEEE},
	keywords = {ANN, LSH ANN},
	pages = {289--300},
	annote = {[TLDR] Comprehensive experiments show that the proposed methods with learned index structure perform much better than the state-of-the-art external memory-based ANNS methods in terms of I/O efficiency and accuracy.},
