	keywords = {ANN, Artificial neural networks, compact encoding, Encoding, image retrieval, Indexing, inverted indexing, IVF ANN, Linear programming, nearest neighbor search, Optimization, Quantization (signal), Quantization ANN, Vector quantization, Vectors},
	pages = {744--755},
	file = {IEEE Xplore Abstract Record:/Users/lianapatel/Zotero/storage/HJU7EIXB/6678503.html:text/html;IEEE Xplore Full Text PDF:/Users/lianapatel/Zotero/storage/XET2EX6Q/Ge et al. - 2014 - Optimized Product Quantization.pdf:application/pdf},
